{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/context/*": ["./src/app/context/*"],
      "@/configs/*": ["./src/app/configs/*"],
      "@/types/*": ["./src/app/types/*"],
      "@/pattern/*": ["./src/app/components/layout-pattern/*"],
      "@app/*": ["./src/app/*"],
      "@/*": ["./src/*"],
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
